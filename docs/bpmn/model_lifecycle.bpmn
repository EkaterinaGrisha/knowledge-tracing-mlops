<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_kt_lifecycle" targetNamespace="https://github.com/EkaterinaGrisha/knowledge-tracing-mlops">
  <bpmn:collaboration id="Collaboration_kt">
    <bpmn:participant id="Participant_kt" name="Жизненный цикл модели knowledge tracing (kt-dkt)" processRef="Process_kt_lifecycle" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kt_lifecycle" name="Жизненный цикл и согласование модели" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kt">
      <bpmn:lane id="Lane_DS" name="Data Scientist / ML-инженер">
        <bpmn:flowNodeRef>SE_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SE_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_card</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pipeline" name="Пайплайн kt train (автоматически)">
        <bpmn:flowNodeRef>T_etl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_dq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_auc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CI" name="CI: GitHub Actions + pre-commit">
        <bpmn:flowNodeRef>T_ci</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ci</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Review" name="Ревьюер (техлид)">
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PO" name="Владелец продукта / методист">
        <bpmn:flowNodeRef>T_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ops" name="Эксплуатация и мониторинг">
        <bpmn:flowNodeRef>T_promote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_promote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_serve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_kept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_drift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_retired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_request" name="Новое требование или задача">
      <bpmn:outgoing>F_req</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SE_request_def" />
    </bpmn:startEvent>
    <bpmn:startEvent id="SE_timer" name="Плановое переобучение (раз в квартал)">
      <bpmn:outgoing>F_timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SE_timer_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_prepare" name="Подготовить изменения в ветке: код, данные, конфигурация">
      <bpmn:incoming>F_req</bpmn:incoming>
      <bpmn:incoming>F_timer</bpmn:incoming>
      <bpmn:incoming>F_dq_no</bpmn:incoming>
      <bpmn:incoming>F_auc_no</bpmn:incoming>
      <bpmn:incoming>F_ci_no</bpmn:incoming>
      <bpmn:incoming>F_review_no</bpmn:incoming>
      <bpmn:incoming>F_drift_alert</bpmn:incoming>
      <bpmn:outgoing>F_prep_etl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_etl" name="ETL: загрузка, очистка, признаки">
      <bpmn:incoming>F_prep_etl</bpmn:incoming>
      <bpmn:outgoing>F_etl_dq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_dq" name="Данные прошли проверки качества?">
      <bpmn:incoming>F_etl_dq</bpmn:incoming>
      <bpmn:outgoing>F_dq_yes</bpmn:outgoing>
      <bpmn:outgoing>F_dq_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_train" name="Обучить BKT, DKT, DKT+Optuna, AutoML; MLflow">
      <bpmn:incoming>F_dq_yes</bpmn:incoming>
      <bpmn:outgoing>F_train_eval</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eval" name="Оценить на тесте: метрики, дрейф, графики">
      <bpmn:incoming>F_train_eval</bpmn:incoming>
      <bpmn:outgoing>F_eval_auc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_auc" name="AUC модели не ниже порога?">
      <bpmn:incoming>F_eval_auc</bpmn:incoming>
      <bpmn:outgoing>F_auc_yes</bpmn:outgoing>
      <bpmn:outgoing>F_auc_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_register" name="Зарегистрировать версию в MLflow (challenger)">
      <bpmn:incoming>F_auc_yes</bpmn:incoming>
      <bpmn:outgoing>F_reg_card</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_card" name="Обновить Model Card, открыть Pull Request">
      <bpmn:incoming>F_reg_card</bpmn:incoming>
      <bpmn:outgoing>F_card_ci</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_ci" name="pre-commit, pytest с покрытием, Docker smoke">
      <bpmn:incoming>F_card_ci</bpmn:incoming>
      <bpmn:outgoing>F_ci_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_ci" name="Проверки пройдены?">
      <bpmn:incoming>F_ci_gw</bpmn:incoming>
      <bpmn:outgoing>F_ci_yes</bpmn:outgoing>
      <bpmn:outgoing>F_ci_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_review" name="Code review и model review">
      <bpmn:incoming>F_ci_yes</bpmn:incoming>
      <bpmn:outgoing>F_review_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_review" name="Одобрено?">
      <bpmn:incoming>F_review_gw</bpmn:incoming>
      <bpmn:outgoing>F_review_yes</bpmn:outgoing>
      <bpmn:outgoing>F_review_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_business" name="Согласовать по Model Card: назначение, риски, ограничения">
      <bpmn:incoming>F_review_yes</bpmn:incoming>
      <bpmn:outgoing>F_business_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_business" name="Согласовано?">
      <bpmn:incoming>F_business_gw</bpmn:incoming>
      <bpmn:outgoing>F_business_yes</bpmn:outgoing>
      <bpmn:outgoing>F_business_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_rejected" name="Версия отклонена">
      <bpmn:incoming>F_business_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_merge" name="Слить PR в main, поставить тег версии">
      <bpmn:incoming>F_business_yes</bpmn:incoming>
      <bpmn:outgoing>F_merge_promote</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_promote" name="kt promote: challenger → champion">
      <bpmn:incoming>F_merge_promote</bpmn:incoming>
      <bpmn:outgoing>F_promote_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_promote" name="Не хуже текущего champion?">
      <bpmn:incoming>F_promote_gw</bpmn:incoming>
      <bpmn:outgoing>F_promote_yes</bpmn:outgoing>
      <bpmn:outgoing>F_promote_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_serve" name="Использовать модель: kt predict, Docker-образ">
      <bpmn:incoming>F_promote_yes</bpmn:incoming>
      <bpmn:outgoing>F_serve_monitor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kept" name="Остаётся прежний champion">
      <bpmn:incoming>F_promote_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_monitor" name="Мониторинг: дрейф PSI/KS, качество, ресурсы">
      <bpmn:incoming>F_serve_monitor</bpmn:incoming>
      <bpmn:incoming>F_timer_monitor</bpmn:incoming>
      <bpmn:outgoing>F_monitor_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_drift" name="Результат мониторинга?">
      <bpmn:incoming>F_monitor_gw</bpmn:incoming>
      <bpmn:outgoing>F_drift_alert</bpmn:outgoing>
      <bpmn:outgoing>F_drift_ok</bpmn:outgoing>
      <bpmn:outgoing>F_drift_retire</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IE_timer" name="Следующая проверка по расписанию">
      <bpmn:incoming>F_drift_ok</bpmn:incoming>
      <bpmn:outgoing>F_timer_monitor</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IE_timer_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_retired" name="Модель выведена из эксплуатации">
      <bpmn:incoming>F_drift_retire</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_req" sourceRef="SE_request" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_timer" sourceRef="SE_timer" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_prep_etl" sourceRef="T_prepare" targetRef="T_etl" />
    <bpmn:sequenceFlow id="F_etl_dq" sourceRef="T_etl" targetRef="GW_dq" />
    <bpmn:sequenceFlow id="F_dq_yes" name="да" sourceRef="GW_dq" targetRef="T_train" />
    <bpmn:sequenceFlow id="F_dq_no" name="нет: DataQualityError" sourceRef="GW_dq" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_train_eval" sourceRef="T_train" targetRef="T_eval" />
    <bpmn:sequenceFlow id="F_eval_auc" sourceRef="T_eval" targetRef="GW_auc" />
    <bpmn:sequenceFlow id="F_auc_yes" name="да" sourceRef="GW_auc" targetRef="T_register" />
    <bpmn:sequenceFlow id="F_auc_no" name="нет: не регистрируется" sourceRef="GW_auc" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_reg_card" sourceRef="T_register" targetRef="T_card" />
    <bpmn:sequenceFlow id="F_card_ci" sourceRef="T_card" targetRef="T_ci" />
    <bpmn:sequenceFlow id="F_ci_gw" sourceRef="T_ci" targetRef="GW_ci" />
    <bpmn:sequenceFlow id="F_ci_yes" name="да" sourceRef="GW_ci" targetRef="T_review" />
    <bpmn:sequenceFlow id="F_ci_no" name="нет: исправить" sourceRef="GW_ci" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_review_gw" sourceRef="T_review" targetRef="GW_review" />
    <bpmn:sequenceFlow id="F_review_yes" name="да" sourceRef="GW_review" targetRef="T_business" />
    <bpmn:sequenceFlow id="F_review_no" name="нет: замечания" sourceRef="GW_review" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_business_gw" sourceRef="T_business" targetRef="GW_business" />
    <bpmn:sequenceFlow id="F_business_yes" name="да" sourceRef="GW_business" targetRef="T_merge" />
    <bpmn:sequenceFlow id="F_business_no" name="нет" sourceRef="GW_business" targetRef="End_rejected" />
    <bpmn:sequenceFlow id="F_merge_promote" sourceRef="T_merge" targetRef="T_promote" />
    <bpmn:sequenceFlow id="F_promote_gw" sourceRef="T_promote" targetRef="GW_promote" />
    <bpmn:sequenceFlow id="F_promote_yes" name="да" sourceRef="GW_promote" targetRef="T_serve" />
    <bpmn:sequenceFlow id="F_promote_no" name="нет: AUC ниже" sourceRef="GW_promote" targetRef="End_kept" />
    <bpmn:sequenceFlow id="F_serve_monitor" sourceRef="T_serve" targetRef="T_monitor" />
    <bpmn:sequenceFlow id="F_monitor_gw" sourceRef="T_monitor" targetRef="GW_drift" />
    <bpmn:sequenceFlow id="F_drift_alert" name="дрейф или деградация" sourceRef="GW_drift" targetRef="T_prepare" />
    <bpmn:sequenceFlow id="F_drift_ok" name="норма" sourceRef="GW_drift" targetRef="IE_timer" />
    <bpmn:sequenceFlow id="F_timer_monitor" sourceRef="IE_timer" targetRef="T_monitor" />
    <bpmn:sequenceFlow id="F_drift_retire" name="модель не нужна" sourceRef="GW_drift" targetRef="End_retired" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kt">
    <bpmndi:BPMNPlane id="BPMNPlane_kt" bpmnElement="Collaboration_kt">
      <bpmndi:BPMNShape id="Participant_kt_di" bpmnElement="Participant_kt" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="3400" height="1150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DS_di" bpmnElement="Lane_DS" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="3370" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pipeline_di" bpmnElement="Lane_Pipeline" isHorizontal="true">
        <dc:Bounds x="150" y="320" width="3370" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CI_di" bpmnElement="Lane_CI" isHorizontal="true">
        <dc:Bounds x="150" y="490" width="3370" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Review_di" bpmnElement="Lane_Review" isHorizontal="true">
        <dc:Bounds x="150" y="640" width="3370" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PO_di" bpmnElement="Lane_PO" isHorizontal="true">
        <dc:Bounds x="150" y="790" width="3370" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ops_di" bpmnElement="Lane_Ops" isHorizontal="true">
        <dc:Bounds x="150" y="960" width="3370" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SE_request_di" bpmnElement="SE_request">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="173" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SE_timer_di" bpmnElement="SE_timer">
        <dc:Bounds x="242" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="263" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_prepare_di" bpmnElement="T_prepare">
        <dc:Bounds x="350" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_etl_di" bpmnElement="T_etl">
        <dc:Bounds x="500" y="365" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_dq_di" bpmnElement="GW_dq" isMarkerVisible="true">
        <dc:Bounds x="685" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="435" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_train_di" bpmnElement="T_train">
        <dc:Bounds x="800" y="365" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_eval_di" bpmnElement="T_eval">
        <dc:Bounds x="950" y="365" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_auc_di" bpmnElement="GW_auc" isMarkerVisible="true">
        <dc:Bounds x="1135" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="435" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_register_di" bpmnElement="T_register">
        <dc:Bounds x="1250" y="365" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_card_di" bpmnElement="T_card">
        <dc:Bounds x="1400" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_ci_di" bpmnElement="T_ci">
        <dc:Bounds x="1550" y="525" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ci_di" bpmnElement="GW_ci" isMarkerVisible="true">
        <dc:Bounds x="1735" y="540" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1700" y="595" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_review_di" bpmnElement="T_review">
        <dc:Bounds x="1850" y="675" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_review_di" bpmnElement="GW_review" isMarkerVisible="true">
        <dc:Bounds x="2035" y="690" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2000" y="745" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_business_di" bpmnElement="T_business">
        <dc:Bounds x="2150" y="835" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_business_di" bpmnElement="GW_business" isMarkerVisible="true">
        <dc:Bounds x="2335" y="850" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2300" y="905" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_rejected_di" bpmnElement="End_rejected">
        <dc:Bounds x="2492" y="857" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2445" y="898" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_merge_di" bpmnElement="T_merge">
        <dc:Bounds x="2450" y="675" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_promote_di" bpmnElement="T_promote">
        <dc:Bounds x="2600" y="1010" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_promote_di" bpmnElement="GW_promote" isMarkerVisible="true">
        <dc:Bounds x="2785" y="1025" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2750" y="980" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_serve_di" bpmnElement="T_serve">
        <dc:Bounds x="2900" y="1010" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_kept_di" bpmnElement="End_kept">
        <dc:Bounds x="2942" y="1137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2895" y="1178" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_monitor_di" bpmnElement="T_monitor">
        <dc:Bounds x="3050" y="1010" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_drift_di" bpmnElement="GW_drift" isMarkerVisible="true">
        <dc:Bounds x="3235" y="1025" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3128" y="1080" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IE_timer_di" bpmnElement="IE_timer">
        <dc:Bounds x="3242" y="1137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3195" y="1178" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_retired_di" bpmnElement="End_retired">
        <dc:Bounds x="3392" y="1032" width="36" height="36" />
        <bpmndi:BPMNLabel>
