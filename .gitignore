.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Data artifacts (raw + processed are regenerated by the pipeline; sample is committed)
data/raw/
data/processed/

# ML experiment tracking
mlruns/
mlartifacts/

# Reports kept under version control: figures, screenshots, metrics.json
# (referenced from README.md as proof of results)

# OS
.DS_Store
*.log
